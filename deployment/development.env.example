APP_ENV=development
API_PORT=8000
API_BIND_HOST=127.0.0.1
HRNOVA_IMAGE=hrnova-api:local
# Créer une base dédiée et l'initialiser avant de déployer.
DATABASE_URL=postgresql+psycopg://hrnova_app:CHANGE_ME@host.docker.internal:5433/hrnova_dev

# Générer avec scripts/manage_users.py --env-file FICHIER
HRNOVA_AUTH_USERS=
# Compte analyste/admin pour le contrôle de déploiement (secrets du processus).
HRNOVA_SMOKE_USERNAME=
HRNOVA_SMOKE_PASSWORD=
