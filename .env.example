# Copier vers .env et renseigner les identifiants du rôle applicatif local.
DATABASE_URL=postgresql+psycopg://hrnova_app:CHANGE_ME@127.0.0.1:5433/hrnova
HRNOVA_MODEL_PATH=artifacts/turnover_model.joblib
# Pour créer une base absente avec un rôle administrateur (script uniquement) :
# DATABASE_ADMIN_URL=postgresql+psycopg://hrnova_admin:CHANGE_ME@127.0.0.1:5433/postgres

# Comptes générés par scripts/manage_users.py ; aucun accès protégé si vide.
HRNOVA_AUTH_USERS=

# Publication du modèle : compte livreur/admin, secrets à renseigner localement ou en CI.
HRNOVA_DELIVERY_USERNAME=
HRNOVA_DELIVERY_PASSWORD=
# Commit source affiché dans les archives téléchargées (facultatif).
HRNOVA_MODEL_REVISION=local
